        "500": "#b28efe",
        "600": "#c2a9fd",
        "700": "#d2c3fb",
        "800": "#e4dbfc",
        "900": "#f6f3ff"
      },
      "accent": "$hue.purple",
      "interactive": "$hue.purple",
      "neutral": "$hue.gray"
    }
  },
  "dark": {
    "hue": {
      "gray": {
        "100": "#f6f1f1",
        "200": "#bfbdb6",
        "300": "#828d8b",
        "400": "#565b66",
        "500": "#3d424b",
