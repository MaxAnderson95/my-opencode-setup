        "400": "#9774bb",
        "500": "#7c5c9b",
        "600": "#61457c",
        "700": "#472f5e",
        "800": "#2f1a42",
        "900": "#190728"
      },
      "accent": "$hue.orange",
      "interactive": "$hue.blue",
      "neutral": "$hue.gray",
      "yellow": {
        "100": "#ffd49b",
        "200": "#e6b673",
        "300": "#c69b5e",
        "400": "#a78049",
        "500": "#896735",
        "600": "#6c4e22",
        "700": "#51370f",
        "800": "#352204",
        "900": "#1b0f00"
      }
    },
    "categorical": [
      "purple",
      "orange",
      "green",
      "blue",
      "red",
      "cyan"
    ],
    "text": {
      "base": "$hue.neutral.200",
      "muted": "$hue.neutral.400",
      "action": {
        "primary": {
          "base": "$text.base",
          "$disabled": "$hue.neutral.400",
          "$focused": "#0b0e14",
          "$selected": "$hue.interactive.200"
        },
        "secondary": {
          "base": "$text.muted",
          "$hovered": "$text.base"
        },
        "destructive": {
          "base": "#0b0e14",
          "$disabled": "$hue.neutral.400"
        }
      },
      "formfield": {
        "base": "$hue.neutral.200",
        "$hovered": "$hue.interactive.200",
        "$focused": "$hue.interactive.200",
        "$pressed": "$hue.interactive.200",
        "$disabled": "$hue.neutral.400",
        "$selected": "$hue.interactive.200"
      },
      "feedback": {
        "error": {
          "base": "$hue.red.200"
        },
        "warning": {
          "base": "#e6b673"
        },
        "success": {
          "base": "$hue.green.200"
        },
        "info": {
          "base": "$hue.cyan.200"
        }
      }
    },
    "background": {
      "base": "$hue.neutral.800",
      "raised": {
        "base": "$hue.neutral.700",
        "high": "$hue.neutral.600",
        "max": "$hue.neutral.500"
      },
      "action": {
        "primary": {
          "base": "transparent",
          "$hovered": "$hue.neutral.700",
          "$focused": "$hue.interactive.200",
          "$selected": "transparent"
        },
        "secondary": {
          "base": "transparent"
        },
        "destructive": {
          "base": "$hue.red.200"
        }
      },
      "formfield": {
        "base": "$background.base"
      },
      "feedback": {
        "error": {
          "base": "$background.base"
        },
        "warning": {
          "base": "$background.base"
        },
        "success": {
          "base": "$background.base"
        },
        "info": {
          "base": "$background.base"
        }
      }
    },
    "border": {
      "base": "#6c7380"
    },
    "scrollbar": {
      "base": "#6c7380"
    },
    "diff": {
      "text": {
        "added": "$hue.green.200",
        "removed": "#f26d78",
        "context": "#acb6bf",
        "hunkHeader": "#acb6bf"
      },
      "background": {
        "added": "#20303b",
        "removed": "#37222c",
        "context": "#0f131a"
      },
      "highlight": {
        "added": "#aad94c",
        "removed": "#f07178"
      },
      "lineNumber": {
        "text": "#6c7380",
        "background": {
          "added": "#1b2b34",
          "removed": "#2d1f26"
        }
      }
    },
    "syntax": {
      "comment": "#acb6bf",
      "keyword": "#ff8f40",
      "function": "#ffb454",
      "variable": "$hue.interactive.200",
      "string": "#aad94c",
      "number": "$hue.purple.200",
      "type": "#e6b673",
      "operator": "#f29668",
      "punctuation": "$hue.neutral.200"
    },
    "markdown": {
      "text": "$hue.neutral.200",
      "heading": "$hue.purple.200",
      "link": "$hue.interactive.200",
      "linkText": "$hue.cyan.200",
      "code": "#aad94c",
      "blockQuote": "#e6b673",
      "emphasis": "#e6b673",
      "strong": "#ffb454",
      "horizontalRule": "$hue.neutral.400",
      "listItem": "$hue.interactive.200",
      "listEnumeration": "$hue.cyan.200",
      "image": "$hue.interactive.200",
      "imageText": "$hue.cyan.200",
      "codeBlock": "$hue.neutral.200"
    },
    "@dialog": {
      "background": {
        "base": "$background.raised.base",
        "action": {
          "primary": {
            "$hovered": "$background.raised.high"
          }
        }
      }
    }
  }
}
