{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "esnext",
    "lib": [
      "esnext"
    ],
    "module": "preserve",
    "moduleResolution": "bundler",
    "types": [
      "bun"
    ],
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid"
  },
  "include": [
    "*.ts",
    "*.tsx"
  ]
}
